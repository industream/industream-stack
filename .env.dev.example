# =============================================================================
# INDUSTREAM PLATFORM - DEVELOPMENT ENVIRONMENT
# =============================================================================
# Overrides for development. Domain and TLS come from base .env.
# Generated automatically on first deploy if .env.dev is missing.
# =============================================================================

# Environment identifier (used for secret/volume/network prefixes)
ENV=dev

# Stack name (used by deploy-swarm.sh)
STACK_NAME=industream-dev

# Backup Configuration (disabled in development)
BACKUP_ENABLED=false

# Notification topic for alerts
NTFY_TOPIC=industream-dev-alerts
