# =============================================================================
# INDUSTREAM PLATFORM - PRODUCTION ENVIRONMENT
# =============================================================================
# Overrides for production. Domain and TLS come from base .env.
# Generated automatically on first deploy if .env.prod is missing.
# =============================================================================

# Environment identifier (used for secret/volume/network prefixes)
ENV=prod

# Stack name (used by deploy-swarm.sh)
STACK_NAME=industream-prod

# Backup Configuration (enabled in production)
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7

# Notification topic for backups
NTFY_TOPIC=industream-prod-backups
