# =============================================================================
# INDUSTREAM PLATFORM - STAGING ENVIRONMENT
# =============================================================================
# Overrides for staging. Domain and TLS come from base .env.
# Generated automatically on first deploy if .env.staging is missing.
# =============================================================================

# Environment identifier (used for secret/volume/network prefixes)
ENV=staging

# Stack name (used by deploy-swarm.sh)
STACK_NAME=industream-staging

# Backup Configuration (disabled in staging)
BACKUP_ENABLED=false

# Notification topic for alerts
NTFY_TOPIC=industream-staging-alerts
