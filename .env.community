# =============================================================================
# .env.community — Override for community mode deployment
# =============================================================================
# Source this file (or prepend with env.community) in addition to the normal
# .env when deploying in community mode. It redirects all BSL image paths to
# the public flowmaker.community project.
#
# Usage:
#   source .env
#   source .env.community
#   ./scripts/deploy-swarm.sh --env prod
#
# All proprietary modules (MODULE_*, PACKAGE_*, ADDON_*) must be excluded
# via --exclude (handled automatically by the Industream CLI).

# All BSL images live under flowmaker.community/ with subfolders
CORE_PROJECT=flowmaker.community/core
BOXES_PROJECT=flowmaker.community/workers
INFRA_PROJECT=flowmaker.community/infra
DATACATALOG_PROJECT=flowmaker.community/data
GRAFANA_PROJECT=flowmaker.community/monitoring
