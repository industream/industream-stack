# =============================================================================
# Enterprise Edition (Logto / OIDC) — extra vars for docker-stack.ee.yml
# =============================================================================
# Appended to the community .env when deploying EE:
#   docker stack deploy -c docker-stack.yml … -c docker-stack.ee.yml ${ENV}
# (deploy-swarm.sh adds docker-stack.ee.yml to STACK_FILES when edition=enterprise.)
#
# The Hub JWT (issuer=hub-backend, audience=industream-hub) is identical to CE —
# downstream apps (Grafana/FlowMaker JWKS) need NO change. Only the identity
# SOURCE changes (internal admin → Logto).
# =============================================================================

# ---- Enterprise image (the -ee variant on the enterprise registry) ----------
ENTERPRISE_REGISTRY=39t88114.c1.gra9.container-registry.ovh.net
UIFUSION_API_EE_VERSION=2.1.0

# ---- Logto (self-hosted) ----------------------------------------------------
LOGTO_VERSION=latest
# Public, browser-facing endpoints — MUST be HTTPS (token-exchange XHR is
# mixed-content-blocked otherwise). Add these hosts to the cert (generate-sans.sh).
LOGTO_ENDPOINT=https://auth.${INDUSTREAM_DOMAIN}
LOGTO_ADMIN_ENDPOINT=https://auth-admin.${INDUSTREAM_DOMAIN}

# ---- OIDC client (the SPA app registered in Logto) --------------------------
# OIDC_ISSUER = LOGTO_ENDPOINT + /oidc (used for `iss` validation + browser exchange).
OIDC_ISSUER=https://auth.${INDUSTREAM_DOMAIN}/oidc
OIDC_CLIENT_ID=industream-hub-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
# `roles` scope REQUIRED for role propagation (Logto roles claim → Hub JWT).
OIDC_SCOPES=openid profile email roles offline_access
# Must EXACTLY match the SPA app's redirect URI in Logto (incl. trailing slash).
OIDC_REDIRECT_URI=https://${INDUSTREAM_DOMAIN}/

# ---- Internal (overlay-network) URLs — no TLS, no mixed-content -------------
OIDC_JWKS_URI=http://logto:3001/oidc/jwks
OIDC_USERINFO_URI=http://logto:3001/oidc/me

# ---- EE-only: upstream revocation monitoring --------------------------------
OIDC_REFRESH_GRANT_ENABLED=true
IH_REVOCATION_CHECK_INTERVAL_SECONDS=300
IH_REVOCATION_HARD_FAIL_AFTER_SECONDS=900
OIDC_INTROSPECTION_URL=

# =============================================================================
# EE deploy prerequisites (coordinate with the community scripts):
#   - create-secrets.sh: add  ${ENV}_logto_db_password  and  ${ENV}_logto_db_url
#       (e.g. DB_URL = postgres://postgres:<pw>@logto-postgres:5432/logto)
#   - generate-sans.sh: add  auth.${INDUSTREAM_DOMAIN}  +  auth-admin.${INDUSTREAM_DOMAIN}
#   - seed Logto (SPA app + roles + admin) — see industream-hub seed-logto.sh
# =============================================================================
