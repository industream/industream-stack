# Industream Docker Compose Environment Variables
# Copy this file to .env and customize values
#
# IMPORTANT: Secrets are managed via Docker Secrets, NOT environment variables
# See docs/SECRET-ROTATION.md for secret management procedures
# Run ./scripts/create-secrets.sh to initialize Docker Secrets

# ============================================
# Domain Configuration
# ============================================
# IMPORTANT: For Let's Encrypt, use a real domain (not .local)
INDUSTREAM_DOMAIN=industream.platform.lan

# ============================================
# TLS / Let's Encrypt Configuration
# ============================================
# TLS mode: selfsigned | letsencrypt
# Use 'letsencrypt' for real public domains.
# Let's Encrypt uses HTTP-01 challenge (per-hostname certs).
# Requirements:
#   - each hostname (e.g. flowmaker.example.com) must have a DNS A record
#     pointing to this server (a wildcard *.example.com → IP works too)
#   - port 80 must be reachable from the public Internet
TLS_MODE=selfsigned

# Email for Let's Encrypt certificate notifications (required when TLS_MODE=letsencrypt)
ACME_EMAIL=admin@example.com

# ============================================
# Docker Registry
# ============================================
# Split registry architecture (see industream-cli/docs/REGISTRY-ARCHITECTURE.md):
#   - COMMUNITY_REGISTRY hosts BSL 1.1 images (anonymous pull from GHCR).
#   - ENTERPRISE_REGISTRY hosts proprietary addons (auth via license-bound robot).
# Each stack file references one of these two variables based on the module's
# license classification in industream-cli/modules.json.
COMMUNITY_REGISTRY=ghcr.io/industream
ENTERPRISE_REGISTRY=39t88114.c1.gra9.container-registry.ovh.net

# Legacy back-compat: kept for installs that have not yet migrated to the
# split-registry layout. New stack files should use COMMUNITY_REGISTRY or
# ENTERPRISE_REGISTRY directly.
DOCKER_REGISTRY=842775dh.c1.gra9.container-registry.ovh.net

# ============================================
# UIFusion Configuration
# ============================================
# v2.x is the new hub with JWT auth, role-based shell, and dynamic nav from
# deployed services. Requires the matching API on UIFUSION_API_VERSION.
UIFUSION_VERSION=2.1.0

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_VERSION=18-alpine
POSTGRES_ADMIN_USER=postgres
# Password managed via Docker Secret: postgres_admin_password

# ============================================
# Hub Backend / JWT Auth (community)
# ============================================
# UIFusion-API runs in hub-backend mode (port 3050, /auth/jwks endpoint).
# Downstream services (FlowMaker, DataCatalog, DataBridge, Grafana wrapper)
# validate JWTs by fetching keys from http://industream-hub-backend:3050/auth/jwks
# inside the platform network.
HUB_AUTH_ISSUER=hub-backend
HUB_AUTH_AUDIENCE=industream-hub
# Admin bootstrap credentials managed via Docker Secrets:
#   - hub_backend_admin_user
#   - hub_backend_admin_password
# Enterprise edition replaces this with Logto (see docker-stack.ee.yml overlay).

# ============================================
# Grafana Configuration
# ============================================
# Vanilla upstream Grafana OSS tag (no more custom grafana-industream build).
# 13.x is a major bump from 12.x — verify volkovlabs + databridge plugin
# compatibility before rolling to prod. Use 13.0.1-security-01 for the
# latest security patch level.
GRAFANA_VERSION=13.0.1
# DataBridge datasource plugin, installed at runtime from its GitHub release.
# Format: "<zip-url>;<plugin-id>". Leave EMPTY to skip (e.g. air-gapped or
# until the release zip is published). The release must carry the .zip as an
# asset — see https://github.com/industream/grafana-databridge/releases
GRAFANA_DATABRIDGE_PLUGIN=https://github.com/industream/grafana-databridge/releases/download/v1.1.0/industream-databridge-datasource-1.1.0.zip;industream-databridge-datasource
GRAFANA_ADMIN_USER=admin
GRAFANA_DB_NAME=industream
GRAFANA_DB_USER=dashboard
# Grafana runtime mode. Keep `production` for every non-dev deployment —
# `development` relaxes a number of security defaults (stricter CSPs, CSRF).
GF_APP_MODE=production
# SSL mode for the Grafana -> Postgres connection. Bundled Postgres has no
# TLS configured, so `disable` is the working default. Set to `require` when
# pointing Grafana at an external Postgres that serves TLS.
GF_DATABASE_SSL_MODE=disable
# Auth: Grafana uses basic auth by default. When the grafana-hub-wrapper
# overlay is enabled, the wrapper injects JWT validation via JWKS from the
# hub-backend. See: https://github.com/industream/grafana-hub-wrapper
# Passwords managed via Docker Secrets:
#   - grafana_admin_password
#   - grafana_db_password

# ============================================
# DataCatalog Configuration
# ============================================
DATACATALOG_API_VERSION=1.9.0
DATACATALOG_UI_VERSION=1.9.0
DATACATALOG_DB_NAME=DataCatalog
DATACATALOG_DB_USER=datacatalog
# Password managed via Docker Secret: datacatalog_db_password

# ============================================
# CDN Cache Configuration (for workers and FlowMaker UI)
# ============================================
CDN_REGISTRY_URL=http://cdn-server:4873
CDN_URL=http://cdn-cache:8080

# ============================================
# InfluxDB Configuration
# ============================================
INFLUXDB_VERSION=2.9.1
INFLUX_ADMIN_USERNAME=admin
INFLUX_ORG=industream
INFLUX_BUCKET=industream
# Passwords managed via Docker Secrets:
#   - influx_admin_password
#   - influx_admin_token

# ============================================
# TimescaleDB Configuration
# ============================================
TIMESCALEDB_VERSION=latest-pg17
TIMESCALEDB_ADMIN_USER=postgres
# Password managed via Docker Secret: timescaledb_password

# ============================================
# Timeseries API Configuration
# ============================================
DATABRIDGE_API_VERSION=2.3.0
DATABRIDGE_PG_DB_NAME=DataBridge
DATABRIDGE_PG_DB_USER=databridge
# Password managed via Docker Secret: databridge_pg_password

# ============================================
# FlowMaker Configuration
# ============================================
# 2.1.0 is the JWT-aware build (validates JWKS from hub-backend).
FLOWMAKER_CORE_VERSION=2.1.0
FLOWMAKER_LOGGER_VERSION=2.1.0
FLOWMAKER_FRONTEND_VERSION=2.1.0
FLOWMAKER_BOX_VERSION=2.0.5
FLOWMAKER_TOOLKIT_VERSION=1.10.1


# ============================================
# Monitoring Configuration
# ============================================
PROMETHEUS_VERSION=v2.48.1
NODE_EXPORTER_VERSION=v1.7.0
CADVISOR_VERSION=v0.56.2
POSTGRES_EXPORTER_VERSION=v0.16.0

# ============================================
# Alerting Configuration
# ============================================
ALERTMANAGER_VERSION=v0.28.1
GOTIFY_VERSION=2.4.0
GOTIFY_ADMIN_USER=admin
# Gotify password should be managed via secret in production

# ============================================
# Timezone
# ============================================
TZ=Europe/Berlin

# ============================================
# Backup Configuration
# ============================================
BACKUP_RETENTION_DAYS=7

# Off-site backup sync (daily 05:00 UTC). When OFFSITE_ENABLED=true, the
# 'offsite' compose profile is activated and the ${ENV}_offsite_ssh_key
# Docker secret must exist (containing the SSH private key for the remote).
OFFSITE_ENABLED=false
OFFSITE_HOST=
OFFSITE_USER=
OFFSITE_PATH=
OFFSITE_PORT=22
OFFSITE_BANDWIDTH_KBPS=0

# Timeseries backend selector: influx | timescale
# Drives which Compose profile is enabled (ts-influx | ts-timescale) so
# only the matching backup job is deployed.
TIMESERIES_BACKEND=influx

# ============================================
# FlowMaker Workers Versions
# ============================================
WORKER_CONDITIONAL_DATASET_VALIDATOR_VERSION=2.0.3
WORKER_DATACATALOG_MAPPER_VERSION=1.0.2
WORKER_DATA_LOGGER_VERSION=2.0.3
WORKER_ENQUEUE_VERSION=2.0.3
WORKER_EQUATION_SOLVER_VERSION=2.0.5
WORKER_HTTP_VERSION=2.0.3
WORKER_INFLUX_CLIENT_VERSION=2.0.8
WORKER_JS_EXPRESSION_VERSION=2.1.7
WORKER_MODBUS_TCP_VERSION=2.1.2
WORKER_MQTT_CLIENT_VERSION=2.2.2
WORKER_NOTIFICATIONS_VERSION=2.0.3
WORKER_OPC_UA_CLIENT_VERSION=2.5.4
WORKER_POSTGRES_CLIENT_VERSION=2.0.5
WORKER_TEST_DATA_GENERATOR_VERSION=2.0.3
WORKER_TIMER_VERSION=2.0.3
WORKER_TIMESERIES_VERSION=2.1.0
WORKER_LUMINOSITY_BOX_VERSION=1.0.0
WORKER_MINIO_SINK_VERSION=1.0.1
WORKER_RTSP_CLIENT_VERSION=1.0.1
CDN_CACHE_VERSION=2.0.2
CDN_SERVER_VERSION=2.0.0
UIFUSION_API_VERSION=2.1.0

# ============================================
# IronStream Configuration
# ============================================
IRONSTREAM_DEMO_VERSION=0.0.1
IRONSTREAM_POSTGRES_VERSION=18-alpine
IRONSTREAM_DB_USER=ironstream
