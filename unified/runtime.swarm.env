# runtime.swarm.env — swarm-topology values consumed by base/*.yml interpolation.
# On swarm every stateful store lives on the shared `postgres` / `timescaledb`
# services; secrets are external docker secrets named `${ENV}_<name>`.
DATACATALOG_DB_HOST=postgres
DATACATALOG_DB_SECRET_NAME=${ENV}_datacatalog_db_password
DATACATALOG_API_KEY_SECRET_NAME=${ENV}_datacatalog_api_key
LOGTO_DB_URL_SECRET_NAME=${ENV}_logto_db_url
LOGTO_DB_PASSWORD_SECRET_NAME=${ENV}_logto_db_password

# --- DB hosts (shared postgres/timescaledb on swarm) ---
GRAFANA_DB_HOST=postgres
POSTGRES_EXPORTER_DB_HOST=postgres
DATABRIDGE_PG_DB_HOST=postgres

# --- secret names (external docker secrets) ---
GRAFANA_ADMIN_PASSWORD_SECRET_NAME=${ENV}_grafana_admin_password
GRAFANA_DB_PASSWORD_SECRET_NAME=${ENV}_grafana_db_password
MINIO_ROOT_USER_SECRET_NAME=${ENV}_minio_root_user
MINIO_ROOT_PASSWORD_SECRET_NAME=${ENV}_minio_root_password
POSTGRES_ADMIN_PASSWORD_SECRET_NAME=${ENV}_postgres_admin_password
TIMESCALEDB_DB_SECRET_NAME=${ENV}_timescaledb_password

# --- dotnet-entrypoint secret-file match patterns (/run/secrets/*_<pattern>) ---
DATABRIDGE_PG_DB_SECRET_PATTERN=databridge_pg_password
TIMESCALEDB_DB_SECRET_PATTERN=timescaledb_password

# --- platform config (explicit; no inline defaults — fail-loud, decision #2) ---
POSTGRES_ADMIN_USER=postgres
INFLUX_ADMIN_USERNAME=admin
INFLUX_ORG=industream
INFLUX_BUCKET=industream
DATACATALOG_DB_USER=datacatalog
DATACATALOG_DB_NAME=DataCatalog
DATABRIDGE_PG_DB_USER=databridge
DATABRIDGE_PG_DB_NAME=DataBridge
TIMESCALEDB_ADMIN_USER=postgres
TIMESCALEDB_DB_NAME=industream
OIDC_CLIENT_ID=industream-hub-app

# --- Grafana OIDC (EE only) ---------------------------------------------------
# The Grafana app is registered in Logto by seed-logto-stack.sh, discovered from
# the io.industream.logto.* labels on the grafana service (runtime/swarm/ee.yml).
# NO SECRET VALUE HERE — only the NAME of the secret, same convention as
# GRAFANA_ADMIN_PASSWORD_SECRET_NAME above. The value is generated by
# create-secrets-ee.sh / deploy.sh, mounted at /run/secrets/<name> and read via
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET__FILE.
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET_NAME=${ENV}_grafana_oidc_client_secret
