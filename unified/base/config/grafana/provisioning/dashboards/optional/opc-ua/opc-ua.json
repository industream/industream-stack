      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (endpoint, outcome) (rate(flowmaker_opcua_reconnects_total{endpoint=~\"$endpoint\"}[$__rate_interval]))",
