#!/usr/bin/env bash
# =============================================================================
# industream — the unified deploy DRIVER (instance lifecycle over deploy.sh).
# =============================================================================
# One driver for the 4-deploy matrix. An "instance" is a named deployment with
# its own edition/runtime/domain/footprint, persisted in instances/<name>/
# instance.env. The driver dispatches to scripts/deploy.sh (the assembler) and
# scripts/setup/ seeders. Folds David's `fm` UX onto the unified base (T4); a
# thin `fm` wrapper can shim `fm <cmd>` → `industream <cmd>` 1:1.
#
#   industream create dev --domain dev.industream.lan --edition ee --runtime compose
#   industream up dev [--render]      # deploy (or dry-render) the instance
#   industream init dev               # post-deploy: ConfigHub + Hub apps (+Logto EE)
#   industream list | ps dev | logs dev [svc] | down dev | delete dev --force
#
# --dry-run (global) prints the commands instead of running them.
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # unified/
ROOT="$(cd "$HERE/.." && pwd)"                            # industream-stack/
INSTANCES_DIR="$HERE/instances"
SEEDERS_DIR="$ROOT/scripts/setup"
DEPLOY="$HERE/scripts/deploy.sh"
DRY_RUN=false

log()  { echo "▶ $*"; }
die()  { echo "✗ $*" >&2; exit 1; }
run()  { if $DRY_RUN; then echo "   + $*"; else "$@"; fi; }

instance_env() { echo "$INSTANCES_DIR/$1/instance.env"; }
load_instance() {
  [[ -f "$(instance_env "$1")" ]] || die "instance '$1' not found — run: industream create $1 …"
  set -a; source "$(instance_env "$1")"; set +a
}
# project (compose) / stack (swarm) name for the loaded instance
target_name() { [[ "$RUNTIME" == compose ]] && echo "fm-$INSTANCE_NAME" || echo "$INSTANCE_NAME"; }

# ---- create -----------------------------------------------------------------
cmd_create() {
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || die "usage: industream create <name> --domain <d> [--runtime compose|swarm] [--edition ce|ee] [--bundle <v>] [--groups \"…\"]"
  local runtime=compose edition=ce domain="" bundle="" groups="core flowmaker datacatalog workers data monitoring"
  while [[ $# -gt 0 ]]; do case "$1" in
    --runtime) runtime="$2"; shift 2 ;;
    --edition) edition="$2"; shift 2 ;;
    --domain)  domain="$2";  shift 2 ;;
    --bundle)  bundle="$2";  shift 2 ;;
    --groups)  groups="$2";  shift 2 ;;
    *) die "unknown create option: $1" ;;
  esac; done
  [[ "$runtime" == compose || "$runtime" == swarm ]] || die "--runtime must be compose|swarm"
  [[ "$edition" == ce || "$edition" == ee ]]         || die "--edition must be ce|ee"
  [[ -n "$domain" ]] || die "--domain required"
  local dir="$INSTANCES_DIR/$name"; mkdir -p "$dir"
  cat > "$dir/instance.env" <<EOF
# industream instance '$name' — generated by 'industream create'
INSTANCE_NAME="$name"
RUNTIME="$runtime"
EDITION="$edition"
INDUSTREAM_DOMAIN="$domain"
BUNDLE="$bundle"
GROUP_SET="$groups"
EOF
  log "created '$name' ($edition/$runtime, domain=$domain, groups=[$groups]) → $dir/instance.env"
}

# ---- build the deploy.sh args for the loaded instance into _DARGS -----------
deploy_args() {
  _DARGS=(--runtime "$RUNTIME" --edition "$EDITION" --groups "$GROUP_SET")
  [[ -n "${BUNDLE:-}" ]] && _DARGS+=(--bundle "$BUNDLE")
  if [[ "$RUNTIME" == compose ]]; then _DARGS+=(--project "$(target_name)")
  else                                  _DARGS+=(--stack   "$(target_name)"); fi
}

# ---- up (deploy or dry-render) ----------------------------------------------
cmd_up() {
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || die "usage: industream up <name> [--render]"
  load_instance "$name"; deploy_args
  [[ "${1:-}" == --render ]] && _DARGS+=(--render)
  export INDUSTREAM_DOMAIN          # instance-supplied deploy-time var
  log "up '$name' → deploy.sh ${_DARGS[*]}"
  run bash "$DEPLOY" "${_DARGS[@]}"
}

# ---- down / ps / logs -------------------------------------------------------
cmd_down() {
  load_instance "${1:?usage: industream down <name>}"
  if [[ "$RUNTIME" == compose ]]; then run docker compose -p "$(target_name)" down
  else                                   run docker stack rm "$(target_name)"; fi
}
cmd_ps() {
  load_instance "${1:?usage: industream ps <name>}"
  if [[ "$RUNTIME" == compose ]]; then run docker compose -p "$(target_name)" ps
  else                                   run docker stack ps "$(target_name)"; fi
}
cmd_logs() {
  load_instance "${1:?usage: industream logs <name> [service]}"; local svc="${2:-}"
  if [[ "$RUNTIME" == compose ]]; then run docker compose -p "$(target_name)" logs -f ${svc:+"$svc"}
  else                                   run docker service logs -f "$(target_name)_${svc:?swarm needs a service name}"; fi
}

# ---- list -------------------------------------------------------------------
cmd_list() {
  [[ -d "$INSTANCES_DIR" ]] || { echo "(no instances)"; return; }
  printf "%-16s %-8s %-9s %s\n" INSTANCE EDITION RUNTIME DOMAIN
  local f n; for f in "$INSTANCES_DIR"/*/instance.env; do
    [[ -f "$f" ]] || continue
    ( set -a; source "$f"; set +a
      printf "%-16s %-8s %-9s %s\n" "$INSTANCE_NAME" "$EDITION" "$RUNTIME" "$INDUSTREAM_DOMAIN" )
  done
}

# ---- delete -----------------------------------------------------------------
cmd_delete() {
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || die "usage: industream delete <name> --force"
  [[ "${1:-}" == --force ]] || die "refusing to delete '$name' without --force (stops + removes instance state)"
  load_instance "$name"; cmd_down "$name" || true
  run rm -rf "$INSTANCES_DIR/$name"
  log "deleted instance '$name'"
}

# ---- init (post-deploy seeding — our standalone seeders, decision #7) --------
cmd_init() {
  load_instance "${1:?usage: industream init <name>}"
  local target; target="$(target_name)"
  log "init '$1' → ConfigHub + Hub apps${EDITION:+ ($EDITION)}"
  run bash "$SEEDERS_DIR/seed-confighub.sh"     --stack "$target" --domain "$INDUSTREAM_DOMAIN"
  run bash "$SEEDERS_DIR/seed-menu-apps-stack.sh" --stack "$target" --domain "$INDUSTREAM_DOMAIN"
  if [[ "$EDITION" == ee ]]; then
    run bash "$SEEDERS_DIR/seed-logto.sh" --stack "$target" --domain "$INDUSTREAM_DOMAIN"
  fi
}

cmd_help() { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; }

# ---- dispatch ---------------------------------------------------------------
ARGS=()
for a in "$@"; do [[ "$a" == --dry-run ]] && DRY_RUN=true || ARGS+=("$a"); done
set -- "${ARGS[@]:-}"
cmd="${1:-help}"; shift || true
case "$cmd" in
  create) cmd_create "$@" ;;
  up)     cmd_up "$@" ;;
  down)   cmd_down "$@" ;;
  ps)     cmd_ps "$@" ;;
  logs)   cmd_logs "$@" ;;
  list)   cmd_list ;;
  delete) cmd_delete "$@" ;;
  init)   cmd_init "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$cmd' (try: industream help)" ;;
esac
