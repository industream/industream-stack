# =============================================================================
# registries.env — license-aware image sources.
# =============================================================================
# Each service in base/*.yml references exactly ONE of these per its license
# classification (BSL community → COMMUNITY_REGISTRY; proprietary → ENTERPRISE).
#   - community CE deploys: COMMUNITY_REGISTRY = anonymous-pull GHCR.
#   - enterprise: ENTERPRISE_REGISTRY = the central customer Harbor (39t…),
#     license-gated robot pull.
# Staging/internal builds may point ENTERPRISE_REGISTRY at 842… instead.
# =============================================================================
COMMUNITY_REGISTRY=ghcr.io/industream
ENTERPRISE_REGISTRY=39t88114.c1.gra9.container-registry.ovh.net
