# =============================================================================
# versions.env — SINGLE SOURCE OF TRUTH for every image tag.
# =============================================================================
# No image tag may appear anywhere else (base/*.yml use ${VAR} with NO inline
# `:-default`, so a missing var fails loudly instead of pulling a stale tag).
# Both deploy paths (swarm `deploy-swarm.sh` / compose `fm`/`deploy.sh`) source
# this file. The release bot bumps ONLY this file.
#
# Values below = the aligned set (industream-stack#21 + compose#228), short
# image names (flow-box-<x> → <x>), verified pullable.
# =============================================================================

# ---- Hub / shell ----
# 2.4.0 = the set shipped by Forge release 2.4.0 (api, ui and api-enterprise
# move together). Lineage kept from main: 2.2.0 added the groups/layout API,
# 2.3.0 the UX quick wins (brand blue #052FAD, rename-on-create, drag ghost).
UIFUSION_API_VERSION=2.4.0
UIFUSION_UI_VERSION=2.4.0               # hub shell (uifusion/ui) — align with the backend
UIFUSION_API_EE_VERSION=2.4.0          # enterprise hub backend (api-enterprise)

# ---- DataCatalog ----
DATACATALOG_API_VERSION=1.9.14
DATACATALOG_UI_VERSION=1.9.5

# ---- FlowMaker core ----
FLOWMAKER_CORE_VERSION=2.1.0
FLOWMAKER_FRONTEND_VERSION=2.1.1
FLOWMAKER_LOGGER_VERSION=2.1.0

# ---- Core: MinIO + CDN ----
MINIO_VERSION=RELEASE.2025-02-07T23-21-09Z   # pinned MinIO (swarm source); never `latest`
CDN_SERVER_VERSION=2.0.0                # flowmaker.core/cdn-server (compose+swarm agree)
CDN_CACHE_VERSION=2.0.2                 # flowmaker.core/cdn-cache  (compose+swarm agree)

# ---- DataBridge / data ----
DATABRIDGE_API_VERSION=2.5.0
INFLUXDB_VERSION=2.9.1                  # influxdb (data source default)
TIMESCALEDB_VERSION=2.17.2-pg17         # timescale/timescaledb — pinned (NEVER `latest`)

# ---- Workers (community → ghcr) ----
WORKER_CONDITIONAL_DATASET_VALIDATOR_VERSION=2.0.3
WORKER_DATACATALOG_MAPPER_VERSION=1.0.4
WORKER_DATA_LOGGER_VERSION=2.0.3
WORKER_ENQUEUE_VERSION=2.0.3
WORKER_EQUATION_SOLVER_VERSION=2.0.6
WORKER_HTTP_VERSION=2.0.3
WORKER_INFLUX_CLIENT_VERSION=2.0.9
WORKER_JS_EXPRESSION_VERSION=2.1.3
WORKER_MODBUS_TCP_VERSION=2.1.6
WORKER_MQTT_CLIENT_VERSION=2.2.3
WORKER_NOTIFICATIONS_VERSION=2.0.3
WORKER_POSTGRES_CLIENT_VERSION=2.0.6
WORKER_TEST_DATA_GENERATOR_VERSION=2.0.3
WORKER_TIMER_VERSION=2.0.3
WORKER_TIMESERIES_VERSION=2.1.2

# ---- Workers (enterprise → ENTERPRISE_REGISTRY) ----
WORKER_OPC_UA_CLIENT_VERSION=2.5.17
WORKER_RTSP_CLIENT_VERSION=1.0.1
WORKER_LUMINOSITY_BOX_VERSION=1.0.0
WORKER_MINIO_SINK_VERSION=1.0.1

# ---- EE / IdP ----
# Pin Logto (NEVER `latest`) — a fresh-DB migration on a moving `latest` is what
# crash-looped the greenfield EE deploy (industream-stack#22).
LOGTO_VERSION=1.40.1

# ---- Infra ----
GRAFANA_VERSION=13.0.1
POSTGRES_VERSION=18-alpine

# ---- Monitoring ----
GRAFANA_WRAPPER_VERSION=1.2.0           # grafana-hub-wrapper (COMMUNITY / GHCR — CE); 1.2.0 = edition gate (IS_OIDC_EDITION, set from INDUSTREAM_OIDC_ORIGIN) so CE never runs the OIDC paths; three-state session probe (only 401/403 mean "no session", a 5xx/503/timeout means "cannot tell" and loads the frame anyway); identity guard also re-runs on every token change, so switching Hub user swaps Grafana without a manual refresh; no `sub` fallback (a missing claim is not a different user); one logout per user per page life; EE-only revocation timer (60s, confirmed via getAccessToken); ?auth_token= dropped on EE; origin sanitising in the entrypoint; 1.1.0 (#7) = deep-link tiles (authed navigations + initial path passthrough), authed no-cors subresources (avatars), clipboard allowed in the Grafana iframe, clean SW 503s; 1.0.4 = "Sign in via the Industream Hub" login prompt on unauth (showHubLoginPrompt) atop 1.0.3; 1.0.3 = SW targets wrapper client (not Grafana iframe) → fixes 401 logout storms; 1.0.2 = lazy DNS resolver

# ---- Ops (optional, opt-in `portainer` group / --with-portainer) ----
PORTAINER_VERSION=2.42.0-alpine         # portainer/portainer-ce (docker.io) — ops console mode A (view + per-service mgmt)
# Industream DataBridge Grafana datasource (custom unsigned plugin). Appended to
# GF_INSTALL_PLUGINS in base/monitoring.yml — carries its OWN leading comma and
# the `<url>;<plugin-id>` form. MUST be quoted: the `;` would otherwise break the
# `source versions.env` the swarm deploy does (validated: survives source + the
# compose --env-file). Public release on github.com/industream/grafana-databridge.
# NOTE: pin to a PUBLISHED release only — Grafana crash-loops (exit 1) at boot if
# GF_INSTALL_PLUGINS points at a missing archive (404). Verify the asset returns 200
# before bumping (v1.1.4 was briefly a DRAFT: asset present, 404 on the canonical URL).
# v1.2.0 (#25) = WHERE autocomplete, mean→avg fix, query cache/perf. It carries #24
# (shipped in v1.1.5), WITHOUT which the asset tree shows NO tags: the plugin keyed the
# tree filter on CatalogEntry.ID (the per-binding id) while asset nodes reference the
# logical entryId, so every entry under a node was filtered out (search still worked).
# Floor note kept from main: the demo dashboards' saved query targets require
# >= v1.1.4 (v1.1.2 rejects them with "no valid targets found").
# Format follows GF_PLUGINS_PREINSTALL_SYNC (see base/monitoring.yml): the old
# `<url>;<id>` form belonged to the deprecated GF_INSTALL_PLUGINS and is NOT
# understood by the preinstall settings — it is `<id>@<version>@<url>` now.
GRAFANA_DATABRIDGE_PLUGIN=",industream-databridge-datasource@1.2.0@https://github.com/industream/grafana-databridge/releases/download/v1.2.0/industream-databridge-datasource-1.2.0.zip"
PROMETHEUS_VERSION=v3.2.1
NODE_EXPORTER_VERSION=v1.9.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor  # upstream moved to ghcr in v0.56+
CADVISOR_VERSION=v0.57.0
POSTGRES_EXPORTER_VERSION=v0.16.0
ALERTMANAGER_VERSION=v0.28.1

# ---- IronStream (EE-licensed domain module — opt-in `ironstream` group) ----
# Versions mirror the live .55 stack (project `ironstream`). Repo paths under
# ironstream/* on the enterprise registry; rendered into the bundle by
# render-bundles.sh (class=enterprise). filebrowser is a third-party ops tool
# (not in the bundle — direct image:${VERSION} ref, like cadvisor/prometheus).
MATERIAL_CATALOG_API_VERSION=1.0.0-dev.13
MATERIAL_CATALOG_UI_VERSION=1.0.0-dev.13
MATERIAL_CATALOG_WORKER_VERSION=1.0.0-dev.8
RECIPE_MAKER_API_VERSION=v20-beta
RECIPE_MAKER_UI_VERSION=v20-beta
BURDEN_DESCENT_API_VERSION=v0-alpha
BURDEN_DESCENT_UI_VERSION=v0-alpha
BURDEN_LAYER_API_VERSION=v0-alpha
RACEWAY_UI_VERSION=1.0.0-preview.2
RACEWAY_WORKER_VERSION=1.0.0-preview.2
FILEBROWSER_VERSION=v2.63.5

# ---- data-simulator (EE demo feed — opt-in `data-simulator` group) ----
DATA_SIMULATOR_VERSION=2.1.0
MOSQUITTO_VERSION=2                       # eclipse-mosquitto (third-party, not in bundle)
TELEGRAF_VERSION=1.32-alpine              # telegraf (third-party, not in bundle)
