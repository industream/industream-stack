# =============================================================================
# auth.env — the Hub JWT contract. THE INVARIANT. NEVER CHANGES.
# =============================================================================
# Every JWKS verifier on the platform (datacatalog-api, grafana, flowmaker core)
# trusts a Hub-minted JWT with THESE exact values. CE (native admin) and EE
# (Logto) mint the SAME token — only the identity SOURCE differs. Changing any
# of these silently breaks SSO for ALL apps. validate-parity.sh lint-enforces
# these literals across the tree.
# =============================================================================
HUB_AUTH_ISSUER=hub-backend
HUB_AUTH_AUDIENCE=industream-hub
HUB_AUTH_JWKS_URL=http://industream-hub-backend:3050/auth/jwks
