# unified/.env.dev.example — per-deploy env for `--env dev` on the compose runtime.
# =============================================================================
# Copy to `unified/.env.dev` (gitignored) and adjust the domain for your host.
# deploy.sh sources `unified/.env.<env>` LAST, so values here override the
# registries/versions/runtime env files.
#
# These are the per-deploy knobs the platform base/*.yml interpolate but that
# have NO sensible repo default (they differ per host/topology):
#   - FM_NETWORK          the shared bridge; runtime/compose/*.yml declare it
#                         external:true, and deploy.sh auto-creates it from here.
#   - INDUSTREAM_DOMAIN   the Traefik host suffix (URLs baked into UIs/CORS).
#   - SECRETS_DIR         absolute path to the file secrets. Generate them with
#                           scripts/setup/create-secrets.sh --env dev
#                         which writes <repo>/secrets/dev/<name>, then point here.
# (GRAFANA_DB_USER/NAME + GF_DATABASE_SSL_MODE now have defaults in
#  runtime.compose.env — no need to repeat them per env.)
# =============================================================================
INDUSTREAM_DOMAIN=compose.industream.lan
FM_DOMAIN=compose.industream.lan
FM_NETWORK=dev-net
INDUSTREAM_HUB_ORIGIN=https://compose.industream.lan
SECRETS_DIR=/absolute/path/to/industream-platform/secrets/dev
ENV=dev
