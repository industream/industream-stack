# runtime.compose.env — compose-topology values consumed by base/*.yml interpolation.
DATACATALOG_DB_HOST=datacatalog-postgresql
DATACATALOG_DB_SECRET_NAME=datacatalog_db_password
DATACATALOG_API_KEY_SECRET_NAME=datacatalog_api_key
LOGTO_DB_URL_SECRET_NAME=logto_db_url
LOGTO_DB_PASSWORD_SECRET_NAME=logto_db_password

# --- DB hosts (dedicated DBs on compose) ---
GRAFANA_DB_HOST=grafana-postgresql
DATABRIDGE_PG_DB_HOST=databridge-postgresql-db
POSTGRES_EXPORTER_DB_HOST=postgres
# --- secret file names (compose file secrets, no env prefix) ---
MINIO_ROOT_USER_SECRET_NAME=minio_root_user
MINIO_ROOT_PASSWORD_SECRET_NAME=minio_root_password
GRAFANA_ADMIN_PASSWORD_SECRET_NAME=grafana_admin_password
GRAFANA_DB_PASSWORD_SECRET_NAME=grafana_db_password
POSTGRES_ADMIN_PASSWORD_SECRET_NAME=postgres_admin_password
TIMESCALEDB_DB_SECRET_NAME=timescaledb_password
# --- dotnet-entrypoint secret-file match patterns (/run/secrets/*_<pattern>) ---
DATABRIDGE_PG_DB_SECRET_PATTERN=databridge_pg_password
TIMESCALEDB_DB_SECRET_PATTERN=timescaledb_password

# --- platform config (explicit; no inline defaults — fail-loud, decision #2) ---
POSTGRES_ADMIN_USER=postgres
INFLUX_ADMIN_USERNAME=admin
INFLUX_ORG=industream
INFLUX_BUCKET=industream
DATACATALOG_DB_USER=datacatalog
DATACATALOG_DB_NAME=DataCatalog
DATABRIDGE_PG_DB_USER=databridge
DATABRIDGE_PG_DB_NAME=DataBridge
TIMESCALEDB_ADMIN_USER=postgres
TIMESCALEDB_DB_NAME=industream
OIDC_CLIENT_ID=industream-hub-app
# oauth2-proxy's Logto client id (per-deploy). Set the real value in .env.${ENV}.
OAUTH2_PROXY_CLIENT_ID=
